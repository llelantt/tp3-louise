# Copiez ce fichier en .env et ajustez les valeurs pour le developpement local.

NODE_ENV=development
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# PostgreSQL + PostGIS
DATABASE_URL=postgres://carbu:carbu@localhost:5432/carbu
DB_STATEMENT_TIMEOUT_MS=10000

# HTTP
# CORS : liste d'origines separees par des virgules, ou * en developpement
# (en production, * est refuse et aucune origine croisee n'est autorisee).
CORS_ORIGINS=*
# TRUST_PROXY : false (defaut), true, un nombre de sauts, ou une liste de proxys.
# Un reglage trop large permet de falsifier X-Forwarded-For (cf. README).
TRUST_PROXY=false
BODY_LIMIT_BYTES=1048576
REQUEST_TIMEOUT_MS=15000

# Documentation OpenAPI sur /docs. true pour la demo ; false recommande en production.
DOCS_ENABLED=true

# Rate limiting (garde-fou global par IP)
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW=1 minute

# Sel ajoute avant le hachage des cles API (jamais committer la vraie valeur).
API_KEY_PEPPER=change-me-in-production

# Ingestion (open data roulez-eco / prix-carburants.gouv.fr)
INGEST_INSTANT_URL=https://donnees.roulez-eco.fr/opendata/instantane
INGEST_DAILY_URL=https://donnees.roulez-eco.fr/opendata/jour
INGEST_INTERVAL_MINUTES=12
INGEST_ENABLED=false
INGEST_MAX_ARCHIVE_BYTES=104857600
PRICE_STALE_AFTER_DAYS=3
